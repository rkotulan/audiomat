# Copy to .env (gitignored) and edit to taste.
# Read by docker-compose.yml at `docker compose up`.

# Where the audiomat library lives on the host. Default = ./data
# relative to the compose file. Use forward slashes on Windows
# (Docker Desktop normalizes them) — backslashes confuse the YAML
# parser.
#
# AUDIOMAT_DATA=C:/Dev/audiomat-data
# AUDIOMAT_DATA=/srv/audiomat

# Image tag. Default = latest. Pin to a specific release for
# reproducibility (e.g. AUDIOMAT_VERSION=0.3.0).
# AUDIOMAT_VERSION=latest

# Host port mapped to the container's :7860. Change if 7860 is taken.
# AUDIOMAT_PORT=7860
